# ==========================================
# COUNCIL APPLICATION ENVIRONMENT VARIABLES
# ==========================================

# 1. DATABASE CONFIGURATION (Neon PostgreSQL)
# Placeholders: replace postgres:password@localhost:5432 with your Neon DB connection string
DATABASE_URL="postgresql://placeholder_user:placeholder_password@ep-placeholder.region.aws.neon.tech/council_db?sslmode=require"

# 2. REDIS CONFIGURATION (Upstash or local Redis)
REDIS_URL="redis://localhost:6379"

# 3. CLOUDINARY CONFIGURATION (Media storage & delivery)
CLOUDINARY_CLOUD_NAME="placeholder_cloud_name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="placeholder_api_secret_key"

# 4. SERVER & NETWORK SETTINGS
NODE_ENV="development"
PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# 5. SECURITY & JWT CONFIGURATION
JWT_SECRET="placeholder_jwt_secret_key_minimum_32_characters_long_for_security"
JWT_EXPIRES_IN="7d"

# 6. BUSINESS RULE CONFIGURATIONS
ROOM_GRACE_PERIOD_HOURS=24
DAILY_ROOM_CREATION_LIMIT=15
APPLICATION_TIMEZONE="UTC"
